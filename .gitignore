# ==============================================================================
# Personal Expense Tracker with Data Visualization — .gitignore
# Separates public deployment assets from local environments, bytecode caches,
# IDE configurations, OS artifacts, and runtime logs.
# ==============================================================================

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# IDE, Editor & Tooling Metadata
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Application Runtime Logs (Preserve directory structure via .gitkeep)
logs

# Temporary, Backup & Scratch Files
*.tmp
*.bak
scratch/

# Node / Frontend Tooling Caches (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Explicitly Retain Essential Deliverables and Data Zones
data
outputs/plots